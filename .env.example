# Environment Configuration
# Copy this file to .env and fill in your values

# Database
DB_PASSWORD=barpro_secret

# Flask
FLASK_ENV=development
JWT_SECRET_KEY=change-this-to-a-very-long-random-string-in-production

# Super Admin credentials (created on first run)
SUPER_ADMIN_EMAIL=admin@barpro.in
SUPER_ADMIN_PASSWORD=Admin@123

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=BarPro POS <noreply@barpro.in>

# SMS/WhatsApp (optional)
MSG91_AUTH_KEY=
WHATSAPP_API_KEY=

# AWS S3 (for file storage - optional in dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=barpro-uploads
AWS_REGION=ap-south-1

# Redis
REDIS_PASSWORD=change-this-redis-password-in-production
REDIS_URL=redis://localhost:6379/0

# Frontend
VITE_API_URL=http://localhost:5000
