# Environment Configuration
# Copy this file to .env and fill in your values

# Database
DB_PASSWORD=change-this-db-password

# Flask
FLASK_ENV=production
JWT_SECRET_KEY=change-this-to-a-very-long-random-string-in-production

# Super Admin credentials (created on first run)
SUPER_ADMIN_EMAIL=your@email.com
SUPER_ADMIN_PASSWORD=YourStrongPassword@123

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email (SMTP — use Gmail App Password, not your regular Gmail password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_DEFAULT_SENDER=CheesePOS <noreply@cheesepos.in>

# CORS / Frontend URL (set to your domain or server IP)
CORS_ORIGINS=http://your-server-ip
FRONTEND_URL=http://your-server-ip

# SMS/WhatsApp (optional)
MSG91_AUTH_KEY=
WHATSAPP_API_KEY=

# AWS S3 (for file storage - optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=cheesepos-uploads
AWS_REGION=ap-south-1

# Redis
REDIS_PASSWORD=change-this-redis-password
REDIS_URL=redis://:change-this-redis-password@redis:6379/0

# Frontend
VITE_API_URL=http://localhost:5000
